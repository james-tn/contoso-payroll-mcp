# Contoso Payroll MCP - Microsoft 365 Agents Toolkit environment example.
# Copy to env/.env.dev and provide values. Real environment files are ignored.

# Stable Microsoft 365 app ID used for packaging and OAuth app restriction.
TEAMS_APP_ID=
APP_NAME_SUFFIX=dev

# Public MCP service origin and Streamable HTTP endpoint.
MCP_BASE_URL=https://mcp.example.com
MCP_ENDPOINT_URL=https://mcp.example.com/mcp

# Entra application that exposes the MCP API.
AAD_APP_CLIENT_ID=

# Written by `atk provision --env dev`.
OAUTH_REGISTRATION_ID=
OAUTH_APPLICATION_ID_URI=
