# Local server defaults. Authentication is intentionally disabled for the local
# smoke test; production deployments must enable and fully configure it.
PAYROLL_MCP_HOST=0.0.0.0
PAYROLL_MCP_PORT=3978
PAYROLL_MCP_REQUIRE_AUTH=false
PAYROLL_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
PAYROLL_MCP_DEBUG_TOOL_PAYLOADS=false

# Recommended production pattern: Entra token issued for this MCP API.
# PAYROLL_MCP_REQUIRE_AUTH=true
# PAYROLL_MCP_AUTH_MODE=entra
# PAYROLL_MCP_ENTRA_TENANT_ID=organizations
# PAYROLL_MCP_ENTRA_AUDIENCES=<client-id>,api://<client-id>,<application-id-uri>
# PAYROLL_MCP_ENTRA_REQUIRED_SCOPE=access_as_user
# PAYROLL_MCP_ENTRA_ALLOWED_TENANTS=<customer-tenant-guid>

# Alternative for a third-party OAuth provider with opaque access tokens.
# PAYROLL_MCP_AUTH_MODE=generic
# PAYROLL_MCP_OAUTH_USERINFO_URL=https://identity.example.com/oauth/userinfo
# PAYROLL_MCP_OAUTH_SUBJECT_FIELD=sub
# PAYROLL_MCP_OAUTH_ALLOWED_SUBJECTS=
